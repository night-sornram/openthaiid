{
  "$schema": "../../sdk/web/schema/autofill-clinic-config.schema.json",
  "kind": "openthaiid.autofill-clinic",
  "request": ["citizenId", "thaiName", "birthDate"],
  "map": {
    "citizenId": "#patient-cid",
