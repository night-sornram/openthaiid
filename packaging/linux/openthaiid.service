[Unit]
Description=OpenThaiID local helper (loopback only)
Documentation=https://github.com/night-sornram/openthaiid/blob/dev/docs/installation.md
After=pcscd.service

[Service]
Type=simple
ExecStart=%h/.local/bin/openthaiid serve
Restart=on-failure
RestartSec=3

# Always-on helper without a tray. Listens only on 127.0.0.1.
# No card data is stored.
# Opt-in (not enabled by default):
#   openthaiid service install
#   systemctl --user enable --now openthaiid.service
# Survive logout:
#   loginctl enable-linger $USER
# Prefer XDG autostart (tray/login) when a signed-in session is enough:
#   openthaiid autostart enable

[Install]
WantedBy=default.target
