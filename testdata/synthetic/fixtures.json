  "profiles": {
    "thai-citizen-mvp": {
      "status": "implemented-independently",
      "fields": ["citizenId", "thaiName", "birthDate"],
      "apduForm": "CLA=80 INS=B0 P1=off_hi P2=off_lo Lc=02 Data=00 Le=len",
      "commands": {
        "select": "00A4040008A000000054480001",
        "citizenId": "80B0000402000D",
        "thaiName": "80B00011020064",
        "birthDate": "80B000D9020008"
      },
      "offsets": {
        "citizenId": "0x0004",
        "thaiName": "0x0011",
        "birthDate": "0x00D9"
      },
      "note": "Thai name is a single 100-byte block with '#' delimiters between title/given/middle/family. Birth date year is Buddhist Era on card and Gregorian after parse."
    }
  },
  "fixtures": [
    {
      "name": "citizen-id-13-digits",
      "input": { "rawHex": "31313031373031323334353637" },
      "expect": { "citizenId": "1101701234567" }
    },
    {
      "name": "thai-name-hash-delimited",
      "input": {
        "rawTis620Hex": "",
        "rawUtf8": "นาย#สมชาย##ใจดี",
        "note": "TIS-620 bytes: A2 C1 D2 23 A4 CB A2 B9 C1 23 23 A4 CA B9"
      },
      "expect": {
        "thaiName": {
          "title": "นาย",
          "givenName": "สมชาย",
          "middleName": null,
          "familyName": "ใจดี",
          "fullName": "นาย สมชาย ใจดี"
        }
      }
    },
    {
      "name": "birth-date-be-to-gregorian",
      "input": { "raw": "25330412" },
      "expect": {
        "birthDate": { "year": 1990, "month": 4, "day": 12 }
      },
      "note": "2533 BE → 1990 CE"
    },
    {
      "name": "birth-date-unknown-day",
      "input": { "raw": "25330400" },
      "expect": {
        "birthDate": { "year": 1990, "month": 4, "day": null }
